{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 1,
    "patch": 1
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "INFERENCEOS_WARNINGS_AS_ERRORS": true
      }
    },
    {
      "name": "gcc-base",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/x86_64-elf-gcc.cmake"
    },
    {
      "name": "clang-base",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/x86_64-none-elf-clang.cmake"
    },
    {
      "name": "gcc-host-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_ASM_COMPILER": "gcc",
        "INFERENCEOS_BUILD_HOST_TESTS": true
      }
    },
    {
      "name": "clang-host-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_ASM_COMPILER": "clang",
        "INFERENCEOS_BUILD_HOST_TESTS": true
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC cross-toolchain (Debug)",
      "inherits": "gcc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC cross-toolchain (Release)",
      "inherits": "gcc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang/LLD cross-toolchain (Debug)",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang/LLD cross-toolchain (Release)",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc-host-debug",
      "displayName": "Native GCC hosted tests (Debug)",
      "inherits": "gcc-host-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang-host-debug",
      "displayName": "Native Clang hosted tests (Debug)",
      "inherits": "clang-host-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release"
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug"
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release"
    },
    {
      "name": "gcc-host-debug",
      "configurePreset": "gcc-host-debug"
    },
    {
      "name": "clang-host-debug",
      "configurePreset": "clang-host-debug"
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": false,
        "timeout": 120,
        "noTestsAction": "error"
      }
    },
    {
      "name": "gcc-host",
      "inherits": "test-base",
      "configurePreset": "gcc-host-debug",
      "filter": {
        "include": {
          "label": "^(unit|property)$"
        }
      }
    },
    {
      "name": "clang-host",
      "inherits": "test-base",
      "configurePreset": "clang-host-debug",
      "filter": {
        "include": {
          "label": "^(unit|property)$"
        }
      }
    },
    {
      "name": "gcc-integration",
      "inherits": "test-base",
      "configurePreset": "gcc-host-debug",
      "filter": {
        "include": {
          "label": "^integration$"
        }
      }
    },
    {
      "name": "clang-integration",
      "inherits": "test-base",
      "configurePreset": "clang-host-debug",
      "filter": {
        "include": {
          "label": "^integration$"
        }
      }
    },
    {
      "name": "gcc-fault",
      "inherits": "test-base",
      "configurePreset": "gcc-host-debug",
      "filter": {
        "include": {
          "label": "^fault$"
        }
      }
    },
    {
      "name": "clang-fault",
      "inherits": "test-base",
      "configurePreset": "clang-host-debug",
      "filter": {
        "include": {
          "label": "^fault$"
        }
      }
    },
    {
      "name": "gcc-contract",
      "inherits": "test-base",
      "configurePreset": "gcc-host-debug",
      "filter": {
        "include": {
          "label": "^contract$"
        }
      }
    },
    {
      "name": "clang-contract",
      "inherits": "test-base",
      "configurePreset": "clang-host-debug",
      "filter": {
        "include": {
          "label": "^contract$"
        }
      }
    }
  ]
}
